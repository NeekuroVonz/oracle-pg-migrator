{
  "name": "oracle-pg-migrator",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@migrator/api --filter=@migrator/worker --filter=@migrator/web",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "bun run --filter @migrator/db generate",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d metadata-postgres redis validator-postgres",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "stack:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "stack:down": "docker compose -f infra/docker-compose.yml down"
  },
  "dependencies": {
    "@migrator/config": "workspace:*",
    "@migrator/db": "workspace:*",
    "@migrator/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
